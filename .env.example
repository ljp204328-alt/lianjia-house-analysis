# 复制本文件为 .env 并填入你的真实凭据（.env 不入库，勿提交）
BUSINESS_DB_HOST=192.168.x.x
BUSINESS_DB_PORT=3306
BUSINESS_DB_USER=root
BUSINESS_DB_PASSWORD=<数据库密码>
BUSINESS_DB_NAME=lianjia_analysis

USER_DB_HOST=localhost
USER_DB_PORT=3306
USER_DB_USER=root
USER_DB_PASSWORD=<数据库密码>
USER_DB_NAME=zufangdata

# JWT 服务端签名密钥，至少 32 字节随机字符串
JWT_SECRET_KEY=<至少32字节随机字符串>

# 大模型（AI 问答助手，DeepSeek 为例）
LLM_API_KEY=<你的DeepSeek或智谱Key>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
